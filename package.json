{
  "name": "quiz-buzzer",
  "version": "1.0.0",
  "private": true,
  "description": "Своя игра и Брейн-ринг по Wi-Fi: ПК ведущего + телефоны игроков как кнопки",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --dev",
    "build": "vue-tsc --noEmit -p client/tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p client/tsconfig.json",
    "test": "node --test \"server/test/*.test.js\"",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "multer": "^2.4.0",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "nosleep.js": "^0.12.0",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  }
}
